# Commit only source, configuration, tests, test fixtures and documentation.
# Everything below is installed, generated, local or secret, and is recreated by `pnpm install` / `pnpm dev`.

# ---- Dependencies ----
node_modules/
.pnpm-store/

# ---- Next.js build and generated files ----
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo
# Regenerated by `next dev` on every start
AGENTS.md

# ---- Tests (results, reports, coverage) ----
coverage/
test-results/
playwright-report/
playwright/.cache/
blob-report/

# ---- Secrets and local environment (only the example is committed) ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Claude Code: keep project config, ignore personal settings ----
.claude/settings.local.json

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- Deployment ----
.vercel/
