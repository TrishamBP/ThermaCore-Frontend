# ThermaCore frontend configuration. Copy to .env.local (gitignored) and adjust.
# See .claude/rules/api-integration.md and docs/backend-contract.md.

# Server only: FastAPI origin used by the /api/backend proxy and Server Components.
# Use 127.0.0.1, not localhost (uvicorn binds IPv4; Node resolves localhost to ::1 first).
API_ORIGIN=http://127.0.0.1:8000

# Server only, optional: set only when the backend sets API_AUTH_TOKEN. Never prefix with NEXT_PUBLIC_.
API_AUTH_TOKEN=

# Server only: upper bound for slow POSTs such as /recommendations/generate (milliseconds).
API_PROXY_TIMEOUT_MS=120000

# Browser: same-origin proxy base path (not the backend origin; backend CORS is disabled).
NEXT_PUBLIC_API_BASE_URL=/api/backend/v1

# Browser, optional: simulation run pinned at the top of the run selector (a complete 24 h demo run).
NEXT_PUBLIC_DEMO_RUN_ID=
